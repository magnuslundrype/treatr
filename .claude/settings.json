{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Skill",
      "Read",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx -y modern-web-guidance@latest *)",
      "Bash(npx supabase start)",
      "Bash(npx supabase status)",
      "Bash(npx supabase db reset)",
      "Bash(npx supabase migration new *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\""
          }
        ]
      }
    ]
  }
}
