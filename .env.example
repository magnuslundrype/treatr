# Kopiér til .env.local og udfyld. .env.local kommer ALDRIG i git (se .gitignore).
# I Vercel-previews og produktion sættes værdierne automatisk af Supabase-integrationen.

# --- Supabase (lokalt: kør `npx supabase start` og kopiér fra `npx supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Går uden om RLS. Må KUN bruges i serverkode under src/lib/supabase/. Aldrig NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI-butleren (kun server) ---
ANTHROPIC_API_KEY=

# --- App ---
# Bruges til at bygge bekræftelseslinks til leverandører.
APP_URL=http://localhost:3000

# --- Ingen telemetri fra værktøjer ---
DISABLE_TELEMETRY=1
NEXT_TELEMETRY_DISABLED=1
